    {
        "id": "c31f0811.b2031",
        "type": "function",
        "z": "572a4fbb.49dd48",
        "name": "Create a Chart Array for Chart.js",
        "func": "var starttime = flow.get(\"start-time\");\nvar endtime = flow.get(\"end-time\");\n\n//if (!Array.isArray(msg.payload) || msg.payload.length === 0) {\n   // msg.payload = [];\n    //return msg;\n//}\n\nvar ChartData = [\n    {\n        series: [\"Temperature\", \"Humidity\"],\n        data: [[], []],\n        labels: [\"Temperature\", \"Humidity\"]\n    }\n];\n\nfor (var i = 0; i < msg.payload.length; i++) {\n    var item = msg.payload[i];\n    // Extract the nested payload\n    var p = item.payload;\n\n    // Defensive check\n    if (!p || typeof p.time === 'undefined') {\n        continue;\n    }\n\n    //if (p.time >= starttime && p.time <= endtime) {\n    ChartData[0].data[0].push({ x: p.time, y: p.temp });\n    ChartData[0].data[1].push({ x: p.time, y: p.humidity });\n   // }\n}\n\n// Sort by time ascending\nChartData[0].data[0].sort((a, b) => a.x - b.x);\nChartData[0].data[1].sort((a, b) => a.x - b.x);\n\nmsg.payload = ChartData;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
